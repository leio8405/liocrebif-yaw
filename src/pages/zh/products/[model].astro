---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { productCategories } from '../../../data/products';
import { productSlug } from '../../../data/products/slug';

export function getStaticPaths() {
  const paths = [];
  for (const cat of productCategories) {
    for (const p of cat.products) {
      paths.push({
        params: { model: productSlug(p) },
        props: { product: p, category: cat },
      });
    }
  }
  return paths;
}

const { product, category } = Astro.props;
const detailPath = `/zh/products/${productSlug(product)}/`;

const related = category.products.filter((p) => p.model !== product.model).slice(0, 4);

const detailURL = new URL(Astro.url.pathname, Astro.site).href;
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: product.nameZh,
  about: { '@type': 'Thing', name: product.model },
  description: product.descZh || product.nameZh,
  image: product.image ? new URL(product.image, Astro.site).href : undefined,
  publisher: { '@type': 'Organization', name: 'Wuhan Liocrebif Technology Co., Ltd' },
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '产品中心', item: 'https://www.liocrebif-yaw.top/zh/products/' },
    { '@type': 'ListItem', position: 2, name: category.titleZh, item: `https://www.liocrebif-yaw.top/zh/products/${category.slug}/` },
    { '@type': 'ListItem', position: 3, name: product.model, item: `https://www.liocrebif-yaw.top/zh/products/${productSlug(product)}/` },
  ],
};
---

<BaseLayout
  currentPath={Astro.url.pathname}
  title={`${product.nameZh} | ${product.model}`}
  description={product.descZh || product.nameZh}
>
  <section class="border-b border-rule">
    <div class="container-page py-10 sm:py-12">
      <nav class="font-mono text-xs tracking-[0.05em] text-muted mb-6 flex items-center gap-2 flex-wrap" aria-label="Breadcrumb">
        <a href="/zh/products/" class="hover:text-accent transition-colors">产品中心</a>
        <span>/</span>
        <a href={`/zh/products/${category.slug}/`} class="hover:text-accent transition-colors">{category.titleZh}</a>
        <span>/</span>
        <span class="text-ink">{product.model}</span>
      </nav>
      <div class="grid lg:grid-cols-12 gap-10 items-start">
        <div class="lg:col-span-5">
          <div class="hairline-card bg-paper-2 flex items-center justify-center p-10 min-h-[320px]">
            {product.image ? (
              <img src={product.image} alt={`${product.model} ${product.nameZh}`} class="max-h-[300px] object-contain" />
            ) : (
              <span class="font-mono text-3xl text-muted tracking-tight">{product.model}</span>
            )}
          </div>
        </div>
        <div class="lg:col-span-7">
          <div class="flex items-center gap-3 mb-3 flex-wrap">
            <span class="tag tag--accent">{product.tagZh}</span>
            <span class="font-mono text-sm text-muted">{product.model}</span>
          </div>
          <h1 class="font-display font-semibold tracking-tight text-ink text-3xl sm:text-4xl leading-tight">
            {product.nameZh}
          </h1>
          {product.descZh && (
            <p class="text-ink-2 text-[15px] mt-5 leading-relaxed max-w-2xl">{product.descZh}</p>
          )}
          {product.appsZh && product.appsZh.length > 0 && (
            <div class="flex flex-wrap gap-2 mt-6">
              {product.appsZh.map((app) => <span class="tag">{app}</span>)}
            </div>
          )}
          <div class="flex flex-wrap gap-3 mt-8">
            <a href="/zh/contact/" class="btn-primary">索取资料与报价</a>
            <a href={`mailto:yaw_sales@liocrebif.com?subject=${encodeURIComponent('产品询价: ' + product.model)}`} class="btn-outline">邮件询价</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {product.specTable && product.specTable.rows.length > 0 && (
    <section class="container-page py-14">
      <h2 class="font-mono text-sm tracking-[0.08em] text-muted mb-6">技术规格</h2>
      <div class="hairline-card overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-sm border-collapse">
            <thead>
              <tr class="bg-paper-2 border-b border-rule">
                <th class="text-left py-3 px-5 font-mono text-[11px] tracking-[0.06em] text-muted font-medium min-w-[220px]">参数</th>
                {product.specTable.headers.slice(1).map((h) => (
                  <th class="text-left py-3 px-5 font-mono text-[11px] tracking-[0.06em] text-muted font-medium">{h}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {product.specTable.rows.map((row) => (
                <tr class="border-b border-rule/60 last:border-0 hover:bg-paper-2/60 transition-colors">
                  <td class="py-2.5 px-5 text-ink-2 align-top">{row.k}</td>
                  {row.v.map((v) => (
                    <td class="py-2.5 px-5 text-ink align-top font-medium whitespace-nowrap">{v || '—'}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="border-t border-rule bg-paper-2">
      <div class="container-page py-12">
        <h2 class="font-mono text-sm tracking-[0.08em] text-muted mb-6">同系列其他产品</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {related.map((p) => (
            <a href={`/zh/products/${productSlug(p)}/`} class="hairline-card p-4 group hover:border-accent transition-colors">
              <span class="font-mono text-xs text-muted group-hover:text-accent transition-colors">{p.model}</span>
              <span class="block text-sm text-ink font-medium leading-snug mt-1.5">{p.nameZh}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="border-t border-rule">
    <div class="container-page py-14">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
        <div>
          <h3 class="font-display font-semibold text-ink text-xl">需要详细规格、报价或货期？</h3>
          <p class="text-muted text-sm mt-1.5">告诉我们您的应用场景与需求，我们会在 24 小时内回复。</p>
        </div>
        <a href="/zh/contact/" class="btn-primary shrink-0">发送询盘</a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</BaseLayout>
