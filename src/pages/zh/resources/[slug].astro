---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { resources, getResource } from '../../../data/resources';

export function getStaticPaths() {
  return resources
    .filter((r) => r.zh)
    .map((r) => ({ params: { slug: r.slug }, props: { article: r } }));
}

const { article } = Astro.props;
const zh = article.zh!;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: zh.title,
  description: zh.description,
  datePublished: article.date,
  author: { '@type': 'Organization', name: 'Wuhan Liocrebif Technology Co., Ltd' },
  publisher: { '@type': 'Organization', name: 'Liocrebif Technology' },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '产品中心', item: 'https://www.liocrebif-yaw.top/zh/products/' },
    { '@type': 'ListItem', position: 2, name: '资源', item: 'https://www.liocrebif-yaw.top/zh/resources/' },
    { '@type': 'ListItem', position: 3, name: zh.title },
  ],
};
---

<BaseLayout
  currentPath={Astro.url.pathname}
  title={zh.title}
  description={zh.description}
>
  <section class="border-b border-rule">
    <div class="container-page py-12 sm:py-14">
      <nav class="font-mono text-xs tracking-[0.05em] text-muted mb-6 flex items-center gap-2 flex-wrap" aria-label="Breadcrumb">
        <a href="/zh/resources/" class="hover:text-accent transition-colors">资源</a>
        <span>/</span>
        <span class="text-ink">{article.tag}</span>
      </nav>
      <h1 class="font-display font-semibold tracking-tight text-ink text-3xl sm:text-4xl leading-tight max-w-3xl">
        {zh.title}
      </h1>
      <p class="font-mono text-xs text-muted mt-5">{article.date} · {article.readingTime} min</p>
    </div>
  </section>

  <article class="container-page py-12 sm:py-14">
    <div class="max-w-3xl mx-auto">
      {zh.sections.map((sec) => (
        <section class="mb-10">
          <h2 class="font-display font-semibold text-ink text-2xl tracking-tight mb-4">{sec.h2}</h2>
          <div class="text-ink-2 text-[15px] leading-relaxed space-y-4" set:html={sec.html} />
        </section>
      ))}

      {zh.faq.length > 0 && (
        <section class="mb-10">
          <h2 class="font-display font-semibold text-ink text-2xl tracking-tight mb-5">常见问题</h2>
          {zh.faq.map((f) => (
            <div class="border-b border-rule py-4">
              <h3 class="text-ink font-medium text-[15px]">{f.q}</h3>
              <p class="text-muted text-sm mt-2 leading-relaxed">{f.a}</p>
            </div>
          ))}
        </section>
      )}

      <section class="bg-graphite rounded-lg p-8 sm:p-10 mt-12">
        <h2 class="font-display font-semibold text-paper text-xl mb-2">正在为平台选型传感器？</h2>
        <p class="text-graphite-ink text-sm leading-relaxed max-w-xl">我们的工程团队帮助集成商根据精度、SWaP 与环境要求选择合适的惯性敏感技术，24 小时内回复。</p>
        <div class="flex flex-wrap gap-3 mt-6">
          <a href="/zh/contact/" class="btn-primary text-sm">联系我们的团队</a>
          <a href="/zh/products/" class="inline-flex items-center px-5 py-3 rounded-md border border-paper/40 text-paper text-sm font-medium hover:border-accent hover:text-accent transition-colors">浏览产品</a>
        </div>
      </section>
    </div>
  </article>

  {article.relatedProducts.length > 0 && (
    <section class="border-t border-rule bg-paper-2">
      <div class="container-page py-12">
        <h2 class="font-mono text-sm tracking-[0.08em] text-muted mb-6">文章中提到的产品</h2>
        <div class="grid sm:grid-cols-2 gap-4 max-w-3xl">
          {article.relatedProducts.map((p) => (
            <a href={p.href.replace('/products/', '/zh/products/')} class="hairline-card p-5 group hover:border-accent transition-colors">
              <span class="font-mono text-xs text-muted group-hover:text-accent transition-colors">{p.model}</span>
              <span class="block text-sm text-ink font-medium leading-snug mt-1.5">{p.caption}</span>
            </a>
          ))}
          {article.relatedCategory && (
            <a href={'/zh' + article.relatedCategory.href} class="hairline-card p-5 group hover:border-accent transition-colors flex items-center">
              <span class="text-accent text-sm font-medium">{article.relatedCategory.name} →</span>
            </a>
          )}
        </div>
      </div>
    </section>
  )}

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</BaseLayout>
