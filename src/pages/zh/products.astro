---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations, translatePath } from '../../i18n/utils';
import { productCategories } from '../../data/products';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const categoryMeta = [
  { icon: 'M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 008 4.07M3 15.364c.64-1.319 1-2.8 1-4.364 0-1.457.39-2.823 1.07-4', tags: ['home.tech.ins.tag1', 'home.tech.ins.tag2', null, 'home.tech.ins.tag3'] as (string | null)[] },
  { icon: 'M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182M15 12a3 3 0 11-6 0 3 3 0 016 0z', tags: ['FOG', 'home.tech.gyro.tag2', 'Dual-Axis', 'Tri-Axis'] as (string | null)[] },
  { icon: 'M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244', tags: [] as (string | null)[] },
];

const categoryInfo = [
  { titleKey: 'products.ins.title', descKey: 'products.ins.desc' },
  { titleKey: 'products.gyro.title', descKey: 'products.gyro.desc' },
  { titleKey: 'products.fiber.title', descKey: 'products.fiber.desc' },
];
---

<BaseLayout
  currentPath={Astro.url.pathname}
  title={t('products.title')}
  description={t('products.subtitle')}
>
  <section class="border-b border-surface-800/30">
    <div class="container-page py-16 sm:py-20">
      <div class="tag mb-4">{t('products.title')}</div>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight">Our <span class="text-gradient">Product Lines</span></h1>
      <p class="text-surface-400 text-lg mt-4 max-w-2xl">{t('products.subtitle')}</p>
    </div>
  </section>

  <section class="container-page py-16 sm:py-20 space-y-14">

    {productCategories.map((cat, i) => (
      <>
        {i > 0 && <div class="border-t border-surface-800/30"></div>}
        <div class="grid lg:grid-cols-5 gap-8 items-start">
          <div class="lg:col-span-2">
            <div class="w-12 h-12 rounded-xl gradient-brand flex items-center justify-center mb-4 text-white">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={categoryMeta[i].icon}/></svg>
            </div>
            <h2 class="text-2xl font-bold text-white mb-3">{t(categoryInfo[i].titleKey)}</h2>
            <p class="text-surface-400 text-sm leading-relaxed mb-4">{t(categoryInfo[i].descKey)}</p>
            {categoryMeta[i].tags.length > 0 && (
              <div class="flex flex-wrap gap-2 mb-5">
                {categoryMeta[i].tags.map((tagKey) => tagKey ? <span class="tag">{t(tagKey)}</span> : <span class="tag">North Seeker</span>)}
              </div>
            )}
            <a href={translatePath(`/products/${cat.slug}`, lang)} class="btn-outline text-sm">{t('products.explore')} →</a>
          </div>
          <div class="lg:col-span-3 grid sm:grid-cols-2 gap-4">
            {cat.products.map((p) => (
              <div class="glass-card p-4 flex items-center gap-3">
                {p.image ? (
                  <img src={p.image} alt={p.model} class="w-14 h-14 object-contain rounded-lg bg-surface-900/50" loading="lazy" />
                ) : (
                  <div class="w-14 h-14 rounded-lg gradient-brand flex items-center justify-center text-white text-lg shrink-0">{p.emoji || '📦'}</div>
                )}
                <div>
                  <div class="text-xs text-surface-500 font-mono">{p.model}</div>
                  <h4 class="text-white font-semibold text-sm">{lang === 'zh' ? (p.shortZh || p.nameZh) : (p.shortEn || p.nameEn)}</h4>
                  {p.subEn && <p class="text-surface-400 text-xs mt-0.5">{lang === 'zh' ? p.subZh : p.subEn}</p>}
                </div>
              </div>
            ))}
          </div>
        </div>
      </>
    ))}
  </section>

  <section class="container-page pb-20">
    <div class="glass-card p-10 text-center">
      <h3 class="text-2xl font-bold text-white">{t('home.cta.title')}</h3>
      <p class="text-surface-400 mt-2">{t('home.cta.subtitle')}</p>
      <a href={translatePath('/contact', lang)} class="btn-primary mt-6 text-base">{t('home.cta.button')} →</a>
    </div>
  </section>
</BaseLayout>
