---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations, translatePath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
// FAQ — 全部为站内既有事实
const faq = [
  {
    q: '是否支持 OEM / ODM 定制？',
    a: '支持。我们在自有 13,300㎡ 光电产业园内自主制造光纤环、陀螺核心与惯性测量单元，可为批量订单提供定制。',
  },
  {
    q: '询盘后多久能收到回复？',
    a: '所有询盘由我们的销售与工程团队在 24 小时内回复。',
  },
  {
    q: '是否支持国际发货？',
    a: '支持。我们的导航与传感产品已服务全球 30 多个国家的航空航天、国防与工业领域客户。',
  },
  {
    q: '下单前能否先索取资料？',
    a: '可以。通过上方询盘表单或直接邮件联系我们，资料通常会随首次回复一并发送。',
  },
  {
    q: '面向个人用户还是企业客户？',
    a: '我们是 B2B 制造商，客户为航空航天、国防、航海、测绘与工业领域的系统集成商和企业。',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

---

<BaseLayout
  currentPath={Astro.url.pathname}
  title={t('nav.contact')}
  description={t('contact.subtitle')}
>
  <section class="border-b border-rule">
    <div class="container-page py-14 sm:py-16">
      <p class="eyebrow mb-4">联系我们</p>
      <h1 class="font-display font-semibold tracking-tight text-ink text-3xl sm:text-4xl">{t('contact.title')}</h1>
      <p class="text-muted text-lg mt-4 max-w-2xl leading-relaxed">{t('contact.subtitle')}</p>
    </div>
  </section>

  





<section class="container-page py-14 sm:py-20">
    <div class="grid lg:grid-cols-5 gap-12">
      <!-- Inquiry Form -->
      <div class="lg:col-span-3">
        <h2 class="font-display font-semibold text-ink text-xl mb-1.5">{t('nav.sendInquiry')}</h2>
        <p class="text-muted text-sm mb-8">{t('contact.sidebar.responseDesc')}</p>

        <form id="inquiry-form" class="space-y-5">
          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="f-name" class="block font-mono text-xs tracking-[0.05em] text-ink-2 mb-2">{t('contact.form.name')} <span class="text-accent">*</span></label>
              <input id="f-name" type="text" name="name" required placeholder={t('contact.form.name')} class="input-field" />
            </div>
            <div>
              <label for="f-company" class="block font-mono text-xs tracking-[0.05em] text-ink-2 mb-2">{t('contact.form.company')}</label>
              <input id="f-company" type="text" name="company" placeholder={t('contact.form.company')} class="input-field" />
            </div>
          </div>

          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="f-email" class="block font-mono text-xs tracking-[0.05em] text-ink-2 mb-2">{t('contact.form.email')} <span class="text-accent">*</span></label>
              <input id="f-email" type="email" name="email" required placeholder={t('contact.form.email')} class="input-field" />
            </div>
            <div>
              <label for="f-phone" class="block font-mono text-xs tracking-[0.05em] text-ink-2 mb-2">{t('contact.sidebar.phone')} / WhatsApp</label>
              <input id="f-phone" type="tel" name="phone" placeholder="+国家区号和号码" class="input-field" />
            </div>
          </div>

          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="f-product" class="block font-mono text-xs tracking-[0.05em] text-ink-2 mb-2">{t('contact.form.product')}</label>
              <select id="f-product" name="product" class="input-field">
                <option value="">{t('contact.form.product.placeholder')}</option>
                <option value="INS">{t('contact.form.product.ins')}</option>
                <option value="Gyroscopes">{t('contact.form.product.gyro')}</option>
                <option value="Fiber">{t('contact.form.product.fiber')}</option>
                <option value="IMU">惯性测量单元 (IMU)</option>
                <option value="Accelerometers">加速度计</option>
                <option value="Calibration">标定设备</option>
                <option value="Anti-Jamming">抗干扰通信</option>
                <option value="Other">{t('contact.form.product.other')}</option>
              </select>
            </div>
            <div>
              <label for="f-industry" class="block font-mono text-xs tracking-[0.05em] text-ink-2 mb-2">{t('contact.form.industry')}</label>
              <select id="f-industry" name="industry" class="input-field">
                <option value="">{t('contact.form.industry.placeholder')}</option>
                <option value="Aerospace">{t('contact.form.industry.aerospace')}</option>
                <option value="Marine">{t('contact.form.industry.marine')}</option>
                <option value="Autonomous">{t('contact.form.industry.autonomous')}</option>
                <option value="Surveying">{t('contact.form.industry.surveying')}</option>
                <option value="Power">{t('home.industries.electric')}</option>
                <option value="Transport">{t('home.industries.transportation')}</option>
                <option value="Defense">{t('contact.form.industry.defense')}</option>
                <option value="Other">{t('contact.form.industry.other')}</option>
              </select>
            </div>
          </div>

          <div>
            <label for="f-message" class="block font-mono text-xs tracking-[0.05em] text-ink-2 mb-2">{t('contact.form.message')} <span class="text-accent">*</span></label>
            <textarea id="f-message" name="message" required rows="5" placeholder={t('contact.form.message.placeholder')} class="input-field resize-none"></textarea>
          </div>

          <button type="submit" class="btn-primary w-full justify-center">
            {t('contact.form.submit')}
          </button>

          <p id="form-success" class="hidden text-center text-accent text-sm py-4 bg-accent-soft rounded-md border border-accent/30">
            {t('contact.form.success')}
          </p>
          <p id="form-error" class="hidden text-center text-red-600 text-sm py-4 bg-red-50 rounded-md border border-red-200">
            {t('contact.form.error')}
          </p>
        </form>
      </div>

      <!-- Quick Contact -->
      <div class="lg:col-span-2">
        <h2 class="font-display font-semibold text-ink text-xl mb-6">{t('contact.sidebar.title')}</h2>

        <div class="space-y-4">
          <div class="hairline-card p-5">
            <div class="flex items-start gap-4">
              <div class="w-9 h-9 rounded-md border border-rule flex items-center justify-center text-ink-2 flex-shrink-0">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/></svg>
              </div>
              <div>
                <div class="text-sm font-medium text-ink">{t('contact.sidebar.whatsapp')}</div>
                <a href="https://wa.me/8618062673472" class="font-mono text-sm text-accent hover:underline" target="_blank">+86 180-6267-3472</a>
                <p class="text-muted text-xs mt-1">快速询价首选</p>
              </div>
            </div>
          </div>

          <div class="hairline-card p-5">
            <div class="flex items-start gap-4">
              <div class="w-9 h-9 rounded-md border border-rule flex items-center justify-center text-ink-2 flex-shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <div class="text-sm font-medium text-ink">{t('contact.sidebar.email')}</div>
                <a href="mailto:yaw_sales@liocrebif.com" class="font-mono text-sm text-accent hover:underline">yaw_sales@liocrebif.com</a>
                <p class="text-muted text-xs mt-1">技术咨询请发邮件</p>
              </div>
            </div>
          </div>

          <div class="hairline-card p-5">
            <div class="flex items-start gap-4">
              <div class="w-9 h-9 rounded-md border border-rule flex items-center justify-center text-ink-2 flex-shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <div>
                <div class="text-sm font-medium text-ink">{t('contact.sidebar.phone')}</div>
                <a href="tel:+8618062673472" class="font-mono text-sm text-accent hover:underline">+86 180-6267-3472</a>
                <p class="text-muted text-xs mt-1">紧急事务 24 小时可拨</p>
              </div>
            </div>
          </div>

          <div class="hairline-card p-5">
            <div class="flex items-start gap-4">
              <div class="w-9 h-9 rounded-md border border-rule flex items-center justify-center text-ink-2 flex-shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <div>
                <div class="text-sm font-medium text-ink">{t('contact.sidebar.address')}</div>
                <p class="text-muted text-sm mt-1 leading-relaxed">湖北省武汉市<br/>江夏区江夏大道17号<br/>中国</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Response time -->
        <div class="mt-4 hairline-card p-5 flex items-center gap-5">
          <div class="font-display font-semibold tracking-tight text-accent text-3xl shrink-0">24h</div>
          <div>
            <div class="text-sm font-medium text-ink">{t('contact.sidebar.response')}</div>
            <p class="text-muted text-xs mt-0.5">{t('contact.sidebar.responseDesc')}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-t border-rule">
    <div class="container-page py-14 sm:py-16">
      <h2 class="font-display font-semibold tracking-tight text-ink text-2xl mb-8">常见问题</h2>
      <div class="grid md:grid-cols-2 gap-x-10 gap-y-6 max-w-4xl">
        {faq.map((f) => (
          <div class="border-b border-rule pb-5">
            <h3 class="text-ink font-medium text-[15px]">{f.q}</h3>
            <p class="text-muted text-sm mt-2 leading-relaxed">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- FAQ -->
  <section class="border-t border-rule">
    <div class="container-page py-14 sm:py-16">
      <h2 class="font-display font-semibold tracking-tight text-ink text-2xl mb-8">常见问题</h2>
      <div class="grid md:grid-cols-2 gap-x-10 gap-y-6 max-w-4xl">
        {faq.map((f) => (
          <div class="border-b border-rule pb-5">
            <h3 class="text-ink font-medium text-[15px]">{f.q}</h3>
            <p class="text-muted text-sm mt-2 leading-relaxed">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</BaseLayout>

<script>
  const form = document.getElementById('inquiry-form');
  const success = document.getElementById('form-success');
  const errorEl = document.getElementById('form-error');

  // Replace YOUR_FORM_ID with your Formspree form ID
  // Get one free at: https://formspree.io (30 seconds)
  const FORMSPREE_ID = 'xjgdjndg';

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);

    // If Formspree not configured yet, use mailto fallback
    if (FORMSPREE_ID === 'YOUR_FORM_ID') {
      const subject = encodeURIComponent('Product Inquiry - ' + (data.get('product') || 'General'));
      const body = encodeURIComponent(
        'Name: ' + data.get('name') + '\n' +
        'Company: ' + data.get('company') + '\n' +
        'Email: ' + data.get('email') + '\n' +
        'Phone: ' + data.get('phone') + '\n' +
        'Product: ' + data.get('product') + '\n' +
        'Industry: ' + data.get('industry') + '\n\n' +
        'Message:\n' + data.get('message')
      );
      window.location.href = 'mailto:yaw_sales@liocrebif.com?subject=' + subject + '&body=' + body;
      form.reset();
      success?.classList.remove('hidden');
      return;
    }

    try {
      const res = await fetch('https://formspree.io/f/' + FORMSPREE_ID, {
        method: 'POST',
        body: data,
        headers: { 'Accept': 'application/json' }
      });

      if (res.ok) {
        form.reset();
        success?.classList.remove('hidden');
        errorEl?.classList.add('hidden');
      } else {
        errorEl?.classList.remove('hidden');
        success?.classList.add('hidden');
      }
    } catch {
      errorEl?.classList.remove('hidden');
      success?.classList.add('hidden');
    }
  });
</script>
