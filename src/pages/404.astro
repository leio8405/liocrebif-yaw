---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout currentPath={Astro.url.pathname} title="Page Not Found" description="The page you are looking for does not exist.">
  <section class="container-page py-28 text-center">
    <p class="font-mono text-[11px] uppercase tracking-[0.08em] text-accent mb-6">Error 404</p>
    <h1 class="font-display font-semibold tracking-tight text-ink text-4xl sm:text-5xl">Page not found</h1>
    <p class="text-muted text-lg mt-5 max-w-md mx-auto leading-relaxed">
      The page you are looking for doesn't exist or has been moved. Browse our product catalog instead.
    </p>
    <div class="flex flex-wrap gap-3 justify-center mt-9">
      <a href="/products/" class="btn-primary">Browse Products</a>
      <a href="/contact/" class="btn-outline">Contact Us</a>
    </div>
  </section>
</BaseLayout>
