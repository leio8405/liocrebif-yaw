---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { resources } from '../../data/resources';
---

<BaseLayout
  currentPath={Astro.url.pathname}
  title="Resources & Insights | Liocrebif Technology"
  description="Technical guides on inertial navigation: FOG vs MEMS selection, fiber optic gyroscope technology, north-seeking methods and practical engineering frameworks."
>
  <section class="border-b border-rule">
    <div class="container-page py-14 sm:py-16">
      <p class="eyebrow mb-4">Resources</p>
      <h1 class="font-display font-semibold tracking-tight text-ink text-3xl sm:text-4xl">Insights &amp; Engineering Guides</h1>
      <p class="text-muted text-lg mt-4 max-w-2xl leading-relaxed">
        Practical technical guides on inertial navigation and sensing — written by engineers, for engineers specifying navigation systems.
      </p>
    </div>
  </section>

  <section class="container-page py-14 sm:py-16">
    <div class="grid md:grid-cols-2 gap-5">
      {resources.map((r) => (
        <a href={`/resources/${r.slug}/`} class="hairline-card p-6 sm:p-8 group hover:border-accent transition-colors flex flex-col">
          <div class="flex items-center gap-3 mb-4">
            <span class="tag tag--accent">{r.tag}</span>
            <span class="font-mono text-xs text-muted">{r.date} · {r.readingTime} min read</span>
          </div>
          <h2 class="font-display font-semibold text-ink text-xl leading-snug group-hover:text-accent transition-colors">{r.title}</h2>
          <p class="text-muted text-sm mt-3 leading-relaxed flex-1">{r.description}</p>
          <span class="text-accent text-sm font-medium mt-5 inline-flex items-center gap-1.5 group-hover:gap-2.5 transition-all">
            Read article <span aria-hidden="true">→</span>
          </span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
