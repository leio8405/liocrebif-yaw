---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations, translatePath } from '../i18n/utils';
import { fogGyros } from '../data/products';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const fs60 = fogGyros.find((p) => p.model === 'LKF-FS60') ?? fogGyros[0];

// Hero spec carousel — 3 flagship products, one per technology platform
// All specs from official catalog (01/03/04 册); do not invent values
const heroProducts = [
  {
    model: 'LKF-FS60',
    href: '/products/fog-gyroscopes',
    image: '/images/products/LKF-FS60.png',
    caption: 'Single Axis Medium-High Precision FOG',
    note: '* Grade C spec · Grades A / B available',
    specs: [
      ['Bias stability (1σ, 10s)', '≤0.05 °/h', true],
      ['Angle random walk', '≤0.005 °/√h', false],
      ['Dynamic range', '±500 °/s', false],
      ['Settling time', '<10 s', false],
      ['Operating temp', '-40 ~ +70 °C', false],
    ],
  },
  {
    model: 'LKF-FSI301',
    href: '/products/inertial-navigation-systems',
    image: '/images/products/LKF-FSI301.png',
    caption: 'Fiber Optical Integrated Navigation System',
    note: '* Navigation-grade FOG + MEMS accelerometer combo',
    specs: [
      ['Gyro bias stability', '≤0.03 °/h', true],
      ['North seeking (1σ)', '≤0.1 ° secL', false],
      ['Accelerometer range', '±30 g', false],
      ['Supply voltage', '18~36 V DC', false],
      ['Dimensions', '177×132×99 mm', false],
    ],
  },
  {
    model: 'LKF-MSU105',
    href: '/products/imu',
    image: '/images/products/LKF-MSU105.png',
    caption: 'Micro MEMS Integrated Navigation System',
    note: '* Full-temperature compensation · 0.5 W low power',
    specs: [
      ['Position (1σ)', '3 m / RTK 0.02+1 ppm', true],
      ['Gyro range', '±300 °/s', false],
      ['Gyro bias stability', '≤10 °/h', false],
      ['Power', '0.5 W', false],
      ['Dimensions', '44.8×38.6×21.5 mm', false],
    ],
  },
];
const featured = [
  {
    href: '/products/inertial-navigation-systems',
    img: '/images/products/LKF-FSI301.png',
    model: 'LKF-FSI301',
    title: t('home.featured.fs300.title'),
    desc: t('home.featured.fs300.desc'),
    tag: 'INS',
    meta: `FOG · ${t('home.featured.tag.nav')}`,
  },
  {
    href: '/products/fog-gyroscopes',
    img: '/images/products/LKF-FS60.png',
    model: 'LKF-FS60',
    title: t('home.featured.fs60.title'),
    desc: t('home.featured.fs60.desc'),
    tag: 'Gyroscope',
    meta: `FOG · ${t('home.featured.tag.midHigh')}`,
  },
  {
    href: '/products/fiber-optic',
    img: '/images/products/LKF-RH16.png',
    model: 'LKF-RH16',
    title: t('home.featured.rh16.title'),
    desc: t('home.featured.rh16.desc'),
    tag: 'Fiber Equipment',
    meta: `Equipment · ${t('home.featured.tag.equip')}`,
  },
];
const industries = [
  t('home.industries.aerospace'),
  t('home.industries.marine'),
  t('home.industries.autonomous'),
  t('home.industries.surveying'),
  t('home.industries.electric'),
  t('home.industries.transportation'),
  t('home.industries.defense'),
  t('home.industries.industrial'),
];
---

<BaseLayout
  currentPath={Astro.url.pathname}
  title={t('home.hero.title')}
  description={t('home.hero.subtitle')}
>
  <!-- Hero: title left, spec card right -->
  <section class="border-b border-rule">
    <div class="container-page py-16 sm:py-24 lg:py-28">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-10 items-center">
        <div class="lg:col-span-7">
          <p class="eyebrow mb-6">Precision Inertial Systems</p>
          <h1 class="display-hero max-w-xl">{t('home.hero.title')}</h1>
          <p class="text-muted text-lg mt-6 max-w-xl leading-relaxed">
            {t('home.hero.subtitle')}
          </p>
          <div class="flex flex-wrap gap-3 mt-9">
            <a href={translatePath('/products', lang)} class="btn-primary">
              {t('nav.products')}
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
            <a href={translatePath('/contact', lang)} class="btn-outline">{t('home.cta.datasheet')}</a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="spec-card p-5 sm:p-6" id="hero-spec">
            <div class="flex items-center gap-1.5 pb-4 border-b border-graphite-line">
              <span class="w-2 h-2 rounded-full bg-graphite-line"></span>
              <span class="w-2 h-2 rounded-full bg-graphite-line"></span>
              <span class="w-2 h-2 rounded-full bg-graphite-line"></span>
              <span class="ml-3 text-[11px] tracking-[0.08em] text-graphite-ink uppercase"><span data-model>LKF-FS60</span> · Spec</span>
              <span class="ml-auto font-mono text-[11px] text-graphite-ink" data-counter>01 / 03</span>
            </div>
            <div class="relative mt-4 min-h-[380px]" id="hero-slides">
              {heroProducts.map((p, i) => (
                <div
                  data-slide
                  data-model={p.model}
                  data-href={p.href}
                  class={`absolute inset-0 transition-opacity duration-500 ${i === 0 ? 'opacity-100' : 'opacity-0 pointer-events-none'}`}
                >
                  <div class="rounded-md bg-black flex items-center justify-center p-3 h-40">
                    <img src={p.image} alt={`${p.model} product photo`} class="max-h-full object-contain" loading="lazy" />
                  </div>
                  <dl class="pt-4 space-y-2.5 text-[13px]">
                    {p.specs.map(([k, v, accent]) => (
                      <div class="flex items-baseline justify-between gap-4">
                        <dt class="text-graphite-ink uppercase tracking-[0.06em] text-xs shrink-0">{k}</dt>
                        <dd class={`text-right font-medium ${accent ? 'text-accent' : 'text-paper'}`}>{v}</dd>
                      </div>
                    ))}
                  </dl>
                  <p class="pt-3 font-mono text-[10px] text-graphite-ink">{p.note}</p>
                </div>
              ))}
            </div>
            <div class="flex items-center justify-between pt-4 mt-4 border-t border-graphite-line">
              <div class="flex items-center gap-2">
                <div class="flex items-center gap-2" role="tablist" aria-label="Featured products">
                  {heroProducts.map((p, i) => (
                    <button
                      data-dot
                      data-index={i}
                      aria-label={p.model}
                      class={`w-2.5 h-2.5 transition-colors ${i === 0 ? 'bg-accent' : 'bg-graphite-line hover:bg-graphite-ink'}`}
                    ></button>
                  ))}
                </div>
                <span class="ml-2 inline-flex items-center gap-1.5 text-[11px] font-medium tracking-[0.06em] uppercase text-accent">
                  <span class="w-1.5 h-1.5 bg-accent" aria-hidden="true"></span>
                  In production
                </span>
              </div>
              <a data-link href={heroProducts[0].href} class="text-[11px] font-medium tracking-[0.06em] uppercase text-graphite-ink hover:text-paper transition-colors">
                {t('home.featured.details')}
              </a>
            </div>
          </div>
          <p class="font-mono text-[11px] text-muted mt-3 text-right" data-caption>{heroProducts[0].caption}</p>
        </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats band -->
  <section class="bg-paper-2 border-b border-rule">
    <div class="container-page py-12">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-y-8">
        <div class="text-center md:border-r border-rule">
          <div class="data-number">2019</div>
          <div class="data-label">{t('home.stat.founded')}</div>
        </div>
        <div class="text-center md:border-r border-rule">
          <div class="data-number">50+</div>
          <div class="data-label">{t('home.stat.team')}</div>
        </div>
        <div class="text-center md:border-r border-rule">
          <div class="data-number">30+</div>
          <div class="data-label">{t('home.stat.countries')}</div>
        </div>
        <div class="text-center">
          <div class="data-number">13,300<span class="text-accent text-lg">㎡</span></div>
          <div class="data-label">{t('home.stat.park')}</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core product lines -->
  <section class="container-page py-20 sm:py-28">
    <div class="max-w-2xl reveal">
      <p class="eyebrow mb-4">Technology Platforms</p>
      <h2 class="section-title">{t('home.tech.title')}</h2>
      <p class="section-subtitle">{t('home.tech.subtitle')}</p>
    </div>

    <div class="grid md:grid-cols-3 gap-5 mt-12">
      <a href={translatePath('/products/inertial-navigation-systems', lang)} class="hairline-card product-card reveal group">
        <h3 class="product-card-title">{t('home.tech.ins.title')}</h3>
        <p class="text-muted text-sm mt-2.5 leading-relaxed">{t('home.tech.ins.desc')}</p>
        <div class="flex flex-wrap gap-2 mt-5">
          <span class="tag">{t('home.tech.ins.tag1')}</span>
          <span class="tag">{t('home.tech.ins.tag2')}</span>
          <span class="tag">{t('home.tech.ins.tag3')}</span>
        </div>
        <div class="mt-6 text-accent text-sm font-medium flex items-center gap-1.5 group-hover:gap-2.5 transition-all">
          {t('home.tech.ins.cta')} <span aria-hidden="true">→</span>
        </div>
      </a>

      <a href={translatePath('/products/gyroscopes', lang)} class="hairline-card product-card reveal group">
        <h3 class="product-card-title">{t('home.tech.gyro.title')}</h3>
        <p class="text-muted text-sm mt-2.5 leading-relaxed">{t('home.tech.gyro.desc')}</p>
        <div class="flex flex-wrap gap-2 mt-5">
          <span class="tag">{t('home.tech.gyro.tag1')}</span>
          <span class="tag">{t('home.tech.gyro.tag2')}</span>
          <span class="tag">{t('home.tech.gyro.tag3')}</span>
        </div>
        <div class="mt-6 text-accent text-sm font-medium flex items-center gap-1.5 group-hover:gap-2.5 transition-all">
          {t('home.tech.gyro.cta')} <span aria-hidden="true">→</span>
        </div>
      </a>

      <a href={translatePath('/products/fiber-optic', lang)} class="hairline-card product-card reveal group">
        <h3 class="product-card-title">{t('home.tech.fiber.title')}</h3>
        <p class="text-muted text-sm mt-2.5 leading-relaxed">{t('home.tech.fiber.desc')}</p>
        <div class="flex flex-wrap gap-2 mt-5">
          <span class="tag">{t('home.tech.fiber.tag1')}</span>
          <span class="tag">{t('home.tech.fiber.tag2')}</span>
          <span class="tag">{t('home.tech.fiber.tag3')}</span>
        </div>
        <div class="mt-6 text-accent text-sm font-medium flex items-center gap-1.5 group-hover:gap-2.5 transition-all">
          {t('home.tech.fiber.cta')} <span aria-hidden="true">→</span>
        </div>
      </a>
    </div>
  </section>

  <!-- Differentiator — the page's one graphite band -->
  <section class="bg-graphite">
    <div class="container-page py-20 sm:py-28">
      <div class="grid lg:grid-cols-2 gap-14 items-center">
        <div>
          <p class="eyebrow mb-5">Full-Stack Manufacturing</p>
          <h2 class="font-display font-semibold tracking-tight text-paper text-3xl sm:text-4xl leading-tight">
            {t('home.diff.title1')} to {t('home.diff.title2')}
          </h2>
          <p class="text-graphite-ink mt-5 leading-relaxed">
            {t('home.diff.subtitle')}
          </p>
          <ul class="mt-7 space-y-3.5">
            {[t('home.diff.point1'), t('home.diff.point2'), t('home.diff.point3'), t('home.diff.point4')].map((point) => (
              <li class="flex items-start gap-3 text-paper/90 text-[15px]">
                <span class="mt-1 w-4 h-4 flex items-center justify-center flex-shrink-0 text-accent" aria-hidden="true">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                </span>
                <span>{point}</span>
              </li>
            ))}
          </ul>
          <a href={translatePath('/about', lang)} class="inline-flex items-center gap-2 mt-9 px-5 py-3 rounded-md border border-paper/40 text-paper text-sm font-medium hover:border-accent hover:text-accent transition-colors">
            {t('home.diff.cta')}
          </a>
        </div>
        <div class="lg:pl-10">
          <div class="border-l border-graphite-line pl-8 sm:pl-10">
            <div class="font-display font-semibold tracking-tight text-paper text-6xl sm:text-7xl">13,300<span class="text-accent text-3xl sm:text-4xl">㎡</span></div>
            <div class="font-mono text-xs tracking-[0.08em] uppercase text-graphite-ink mt-3">{t('home.diff.park')}</div>
            <div class="mt-8 space-y-0 divide-y divide-graphite-line border-y border-graphite-line">
              <div class="flex items-center justify-between py-3.5">
                <span class="text-paper/90 text-sm">{t('home.diff.rd')}</span>
                <span class="font-mono text-[11px] text-graphite-ink uppercase tracking-[0.06em]">In-house</span>
              </div>
              <div class="flex items-center justify-between py-3.5">
                <span class="text-paper/90 text-sm">{t('home.diff.production')}</span>
                <span class="font-mono text-[11px] text-graphite-ink uppercase tracking-[0.06em]">In-house</span>
              </div>
              <div class="flex items-center justify-between py-3.5">
                <span class="text-paper/90 text-sm">{t('home.diff.calibration')}</span>
                <span class="font-mono text-[11px] text-graphite-ink uppercase tracking-[0.06em]">In-house</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured products -->
  <section class="container-page py-20 sm:py-28">
    <div class="max-w-2xl reveal">
      <p class="eyebrow mb-4">Product Index</p>
      <h2 class="section-title">{t('home.featured.title')}</h2>
      <p class="section-subtitle">{t('home.featured.subtitle')}</p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5 mt-12">
      {featured.map((p) => (
        <a href={translatePath(p.href, lang)} class="hairline-card overflow-hidden reveal group">
          <div class="h-44 bg-paper-2 border-b border-rule flex items-center justify-center p-5">
            <img src={p.img} alt={p.model} class="max-h-full object-contain" loading="lazy" />
          </div>
          <div class="p-6">
            <div class="flex items-center justify-between mb-3">
              <span class="tag tag--accent">{p.tag}</span>
              <span class="font-mono text-xs text-muted">{p.model}</span>
            </div>
            <h3 class="font-display font-semibold text-ink text-lg leading-snug">{p.title}</h3>
            <p class="text-muted text-sm line-clamp-2 mt-2">{p.desc}</p>
            <div class="mt-5 pt-4 border-t border-rule flex items-center justify-between">
              <span class="font-mono text-[11px] uppercase tracking-[0.05em] text-muted">{p.meta}</span>
              <span class="text-accent text-sm font-medium">{t('home.featured.details')}</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Industries — mono grid, no emoji -->
  <section class="border-t border-rule bg-paper-2">
    <div class="container-page py-20 sm:py-28">
      <div class="max-w-2xl reveal">
        <h2 class="section-title">{t('home.industries.title')}</h2>
        <p class="section-subtitle">{t('home.industries.subtitle')}</p>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 border-t border-l border-rule mt-12 reveal">
        {industries.map((name) => (
          <div class="border-b border-r border-rule px-5 py-7 flex items-center">
            <span class="font-mono text-xs uppercase tracking-[0.06em] text-ink-2">{name}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="container-page py-20 sm:py-28">
    <div class="max-w-2xl reveal">
      <h2 class="font-display font-semibold tracking-tight text-ink text-3xl sm:text-4xl leading-tight">{t('home.cta.title')}</h2>
      <p class="text-muted mt-4 leading-relaxed max-w-xl">{t('home.cta.subtitle')}</p>
      <div class="flex flex-wrap gap-3 mt-8">
        <a href={translatePath('/contact', lang)} class="btn-primary">{t('home.cta.button')}</a>
        <a href="https://wa.me/8618062673472" target="_blank" class="btn-outline">WhatsApp</a>
      </div>
    </div>
  </section>

<script>
  const heroSpec = document.getElementById('hero-spec');
  if (heroSpec) {
    const slides = [...heroSpec.querySelectorAll('[data-slide]')];
    const dots = [...heroSpec.querySelectorAll('[data-dot]')];
    const modelEl = heroSpec.querySelector('[data-model]');
    const counterEl = heroSpec.querySelector('[data-counter]');
    const linkEl = heroSpec.querySelector('[data-link]');
    const captionEl = document.querySelector('[data-caption]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let idx = 0;
    let timer = null;

    function go(i) {
      idx = (i + slides.length) % slides.length;
      slides.forEach((s, n) => {
        s.classList.toggle('opacity-100', n === idx);
        s.classList.toggle('opacity-0', n !== idx);
        s.classList.toggle('pointer-events-none', n !== idx);
      });
      dots.forEach((d, n) => {
        d.classList.toggle('bg-accent', n === idx);
        d.classList.toggle('bg-graphite-line', n !== idx);
      });
      const cur = slides[idx];
      const model = cur.dataset.model || '';
      const no = String(idx + 1).padStart(2, '0');
      if (modelEl) modelEl.textContent = model.replace('LKF-', '');
      if (counterEl) counterEl.textContent = no + ' / ' + String(slides.length).padStart(2, '0');
      if (linkEl && cur.dataset.href) linkEl.href = cur.dataset.href;
      if (captionEl && cur.querySelector('img')) captionEl.textContent = cur.querySelector('img').alt.replace(' product photo', '');
    }

    function startAuto() {
      if (reduced || timer) return;
      timer = setInterval(() => go(idx + 1), 6000);
    }
    function stopAuto() {
      if (timer) { clearInterval(timer); timer = null; }
    }

    dots.forEach((d, n) => d.addEventListener('click', () => { stopAuto(); go(n); startAuto(); }));
    go(0);
    startAuto();
  }
</script>
</BaseLayout>
