---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations, translatePath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const pillars = [
  { label: 'Mission', titleKey: 'about.mission.title', descKey: 'about.mission.desc' },
  { label: 'Vision', titleKey: 'about.vision.title', descKey: 'about.vision.desc' },
  { label: 'Approach', titleKey: 'about.approach.title', descKey: 'about.approach.desc' },
];

const timeline = [
  { year: '2019', title: 'Company Founded', desc: 'Wuhan Liocrebif Technology Co., Ltd established with a focus on inertial navigation and fiber optic sensing technology.' },
  { year: '2020', title: 'Core Technology Development', desc: 'Established in-house FOG and MEMS gyroscope R&D capabilities. Built the core team of inertial navigation experts.' },
  { year: '2022', title: 'Industrial Park & Production Scale-Up', desc: 'Established 13,300㎡ self-owned Optoelectronic Industrial Park with full production lines covering components, sensors, and systems.' },
  { year: '2024', title: 'Global Expansion', desc: 'Products now serving 30+ countries. Continued investment in next-generation navigation technology and international partnerships.' },
];

const facilityStats = [
  { num: '13,300', unit: '㎡', labelKey: 'home.stat.park' },
  { num: '50+', unit: '', labelKey: 'home.stat.team' },
  { num: '30+', unit: '', labelKey: 'home.stat.countries' },
  { num: '24/7', unit: '', label: 'Technical Support' },
];
---

<BaseLayout
  currentPath={Astro.url.pathname}
  title={t('nav.about')}
  description={t('about.mission.desc')}
>
  <section class="border-b border-rule">
    <div class="container-page py-16 sm:py-20">
      <p class="eyebrow mb-5">About Liocrebif</p>
      <h1 class="font-display font-semibold tracking-tight text-ink text-3xl sm:text-4xl lg:text-5xl max-w-3xl leading-tight">
        {t('footer.motto')}
      </h1>
      <p class="text-muted text-lg mt-5 max-w-2xl leading-relaxed">
        Wuhan Liocrebif Technology Co., Ltd is a high-tech enterprise specializing in navigation technology, optical devices, and precision machinery.
      </p>
    </div>
  </section>

  <!-- Mission / Vision / Approach -->
  <section class="container-page py-16 sm:py-20">
    <div class="grid md:grid-cols-3 gap-5">
      {pillars.map((p) => (
        <div class="hairline-card p-8">
          <p class="font-mono text-[11px] tracking-[0.08em] uppercase text-accent mb-4">{p.label}</p>
          <h3 class="font-display font-semibold text-ink text-lg">{t(p.titleKey)}</h3>
          <p class="text-muted text-sm leading-relaxed mt-3">
            {t(p.descKey)}
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- Timeline -->
  <section class="border-t border-rule bg-paper-2">
    <div class="container-page py-16 sm:py-20">
      <h2 class="section-title mb-12">{t('about.timeline.title')}</h2>

      <div class="space-y-0">
        {timeline.map((item, i) => (
          <div class="grid sm:grid-cols-[100px_1fr] gap-x-8">
            <div class="hidden sm:block text-right pt-0.5">
              <span class="font-mono text-sm font-medium text-accent">{item.year}</span>
            </div>
            <div class={`relative pl-6 sm:pl-8 pb-10 ${i < timeline.length - 1 ? 'border-l border-rule' : 'border-l border-transparent'}`}>
              <span class="absolute left-0 top-1.5 -translate-x-1/2 w-2 h-2 bg-accent" aria-hidden="true"></span>
              <div class="sm:hidden font-mono text-sm font-medium text-accent mb-1">{item.year}</div>
              <h3 class="font-display font-semibold text-ink text-lg">{item.title}</h3>
              <p class="text-muted text-sm mt-1.5 leading-relaxed max-w-2xl">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Facility -->
  <section class="container-page py-16 sm:py-20">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <h2 class="section-title">{t('about.facility.title')}</h2>
        <p class="text-muted mt-4 leading-relaxed">
          {t('about.facility.desc')}
        </p>
        <div class="grid grid-cols-2 gap-4 mt-8">
          {facilityStats.map((s) => (
            <div class="hairline-card p-5">
              <div class="data-number text-2xl">{s.num}{s.unit && <span class="text-accent text-base">{s.unit}</span>}</div>
              <div class="data-label">{s.label ?? t(s.labelKey)}</div>
            </div>
          ))}
        </div>
      </div>
      <div class="spec-card p-8 sm:p-10">
        <p class="font-mono text-[11px] tracking-[0.08em] uppercase text-graphite-ink mb-8">Optoelectronic Industrial Park</p>
        <div class="font-display font-semibold tracking-tight text-paper text-5xl sm:text-6xl">13,300<span class="text-accent text-2xl sm:text-3xl">㎡</span></div>
        <div class="font-mono text-xs tracking-[0.06em] uppercase text-graphite-ink mt-3">{t('home.diff.park')}</div>
        <div class="mt-8 divide-y divide-graphite-line border-y border-graphite-line">
          {[t('home.diff.rd'), t('home.diff.production'), t('home.diff.calibration')].map((row) => (
            <div class="flex items-center justify-between py-3.5">
              <span class="text-paper/90 text-sm">{row}</span>
              <span class="font-mono text-[11px] text-graphite-ink uppercase tracking-[0.06em]">In-house</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-rule">
    <div class="container-page py-14">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
        <div>
          <h3 class="font-display font-semibold text-ink text-xl">{t('home.cta.title')}</h3>
          <p class="text-muted text-sm mt-1.5">{t('home.cta.subtitle')}</p>
        </div>
        <a href={translatePath('/contact', lang)} class="btn-primary shrink-0">{t('home.cta.button')}</a>
      </div>
    </div>
  </section>
</BaseLayout>
