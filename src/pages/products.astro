---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations, translatePath } from '../i18n/utils';
import { productCategories } from '../data/products';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const categoryInfo = [
  { titleKey: 'products.ins.title', descKey: 'products.ins.desc' },
  { titleKey: 'products.gyro.title', descKey: 'products.gyro.desc' },
  { titleKey: 'products.fiber.title', descKey: 'products.fiber.desc' },
];
---

<BaseLayout
  currentPath={Astro.url.pathname}
  title={t('products.title')}
  description={t('products.subtitle')}
>
  <section class="border-b border-rule">
    <div class="container-page py-14 sm:py-16">
      <p class="eyebrow mb-4">Product Lines</p>
      <h1 class="font-display font-semibold tracking-tight text-ink text-3xl sm:text-4xl">{t('products.title')}</h1>
      <p class="text-muted text-lg mt-4 max-w-2xl leading-relaxed">{t('products.subtitle')}</p>
    </div>
  </section>

  <section class="container-page py-14 sm:py-20 space-y-16">
    {productCategories.map((cat, i) => (
      <div class={i > 0 ? 'border-t border-rule pt-16' : ''}>
        <div class="grid lg:grid-cols-12 gap-10">
          <div class="lg:col-span-4">
            <h2 class="font-display font-semibold text-ink text-2xl tracking-tight">{t(categoryInfo[i].titleKey)}</h2>
            <p class="text-muted text-sm leading-relaxed mt-3">{t(categoryInfo[i].descKey)}</p>
            <a href={translatePath(`/products/${cat.slug}`, lang)} class="inline-flex items-center gap-1.5 text-accent text-sm font-medium mt-5 hover:gap-2.5 transition-all">
              {t('products.explore')} <span aria-hidden="true">→</span>
            </a>
          </div>
          <div class="lg:col-span-8">
            <div class="border-t border-rule">
              {cat.products.map((p) => (
                <a href={translatePath(`/products/${cat.slug}`, lang)} class="group grid grid-cols-[auto_1fr] sm:grid-cols-[110px_1fr] gap-x-5 items-baseline py-3.5 border-b border-rule hover:bg-paper-2 transition-colors px-2 -mx-2">
                  <span class="font-mono text-xs text-muted group-hover:text-accent transition-colors">{p.model}</span>
                  <span class="min-w-0">
                    <span class="block text-[15px] text-ink font-medium leading-snug">{lang === 'zh' ? (p.shortZh || p.nameZh) : (p.shortEn || p.nameEn)}</span>
                    {p.subEn && <span class="block text-xs text-muted mt-0.5 leading-snug">{lang === 'zh' ? p.subZh : p.subEn}</span>}
                  </span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    ))}
  </section>

  <section class="border-t border-rule bg-paper-2">
    <div class="container-page py-14">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
        <div>
          <h3 class="font-display font-semibold text-ink text-xl">{t('home.cta.title')}</h3>
          <p class="text-muted text-sm mt-1.5">{t('home.cta.subtitle')}</p>
        </div>
        <a href={translatePath('/contact', lang)} class="btn-primary shrink-0">{t('home.cta.button')}</a>
      </div>
    </div>
  </section>
</BaseLayout>
