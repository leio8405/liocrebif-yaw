---
import '../styles/global.css';
import { getLangFromUrl, useTranslations, translatePath, type Lang } from '../i18n/utils';
import { productCategories } from '../data/products';

export interface Props {
  title: string;
  description: string;
  currentPath?: string;
}

const { title, description, currentPath = '/' } = Astro.props;
const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isZh = lang === 'zh';

function isActive(path: string) {
  // Strip /zh prefix for comparison
  const normalizedPath = currentPath.replace(/^\/zh/, '') || '/';
  const normalizedTarget = path;
  if (normalizedTarget === '/') return normalizedPath === '/';
  return normalizedPath.startsWith(normalizedTarget);
}

const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} | Liocrebif Technology</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&family=Noto+Sans+SC:wght@400;500;700&display=swap" rel="stylesheet" />
  <link rel="alternate" hreflang="en" href={`https://www.liocrebif-yaw.top${translatePath(currentPath, 'en')}`} />
  <link rel="alternate" hreflang="zh-CN" href={`https://www.liocrebif-yaw.top${translatePath(currentPath, 'zh')}`} />
  <link rel="alternate" hreflang="x-default" href={`https://www.liocrebif-yaw.top${translatePath(currentPath, 'en')}`} />
</head>
<body class="min-h-screen flex flex-col antialiased">
  <!-- Header: N9 edge-aligned, hairline bottom border -->
  <header class="fixed top-0 left-0 right-0 z-50 bg-paper/90 backdrop-blur-sm border-b border-rule">
    <nav class="container-page flex items-center justify-between h-16">
      <!-- Wordmark -->
      <a href={translatePath('/', lang)} class="flex items-center gap-2.5" aria-label="Liocrebif home">
        <span class="w-2.5 h-2.5 bg-accent" aria-hidden="true"></span>
        <span class="font-display font-semibold text-ink tracking-tight text-base leading-none">LIOCREBIF</span>
        <span class="hidden sm:inline font-mono text-[10px] tracking-[0.14em] text-muted uppercase ml-1 mt-0.5">Yaw Technology</span>
      </a>

      <!-- Desktop Nav -->
      <div class="hidden lg:flex items-center gap-7">
        <a href={translatePath('/', lang)} class={isActive('/') ? 'nav-link nav-link-active' : 'nav-link'}>{t('nav.home')}</a>
        <div class="relative group">
          <a href={translatePath('/products', lang)} class={isActive('/products') ? 'nav-link nav-link-active inline-flex items-center gap-1.5' : 'nav-link inline-flex items-center gap-1.5'}>
            {t('nav.products')}
            <svg class="w-3 h-3 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </a>
          <div class="absolute top-full left-1/2 -translate-x-1/2 pt-3 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
            <div class="bg-paper border border-rule rounded-lg p-1.5 min-w-[280px]">
              {productCategories.map((cat) => (
                <a href={translatePath(`/products/${cat.slug}`, lang)} class="block px-3.5 py-2.5 rounded-md hover:bg-paper-2 transition-colors">
                  <span class="block font-mono text-xs uppercase tracking-wide text-muted hover:text-ink">{isZh ? cat.titleZh : cat.titleEn}</span>
                </a>
              ))}
              <div class="border-t border-rule my-1"></div>
              <a href={translatePath('/products', lang)} class="block px-3.5 py-2.5 rounded-md font-mono text-xs uppercase tracking-wide text-accent hover:bg-accent-soft transition-colors">{t('nav.viewAll')}</a>
            </div>
          </div>
        </div>
        <a href={translatePath('/about', lang)} class={isActive('/about') ? 'nav-link nav-link-active' : 'nav-link'}>{t('nav.about')}</a>
        <a href={translatePath('/contact', lang)} class={isActive('/contact') ? 'nav-link nav-link-active' : 'nav-link'}>{t('nav.contact')}</a>
      </div>

      <!-- Language + CTA + Mobile Toggle -->
      <div class="flex items-center gap-4">
        <div class="hidden sm:flex items-center font-mono text-xs">
          <a href={translatePath(currentPath, 'en')} class={`px-1 ${lang === 'en' ? 'text-ink font-medium' : 'text-muted hover:text-ink'}`}>EN</a>
          <span class="text-rule mx-1">/</span>
          <a href={translatePath(currentPath, 'zh')} class={`px-1 ${lang === 'zh' ? 'text-ink font-medium' : 'text-muted hover:text-ink'}`}>中文</a>
        </div>
        <a href={translatePath('/contact', lang)} class="hidden sm:inline-flex btn-primary !py-2 !px-4 !text-xs font-mono uppercase tracking-wide">
          {t('nav.inquiry')}
        </a>
        <button id="mobile-menu-btn" class="lg:hidden p-2 text-ink" aria-label="Menu" aria-expanded="false">
          <svg id="menu-icon-open" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"/></svg>
          <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
    </nav>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="lg:hidden hidden border-t border-rule bg-paper">
      <div class="container-page py-4 space-y-0.5">
        <a href={translatePath('/', lang)} class={isActive('/') ? 'block px-3 py-2.5 font-mono text-xs uppercase tracking-wide text-ink bg-paper-2 rounded-md' : 'block px-3 py-2.5 font-mono text-xs uppercase tracking-wide text-muted hover:text-ink hover:bg-paper-2 rounded-md transition-colors'}>{t('nav.home')}</a>
        <a href={translatePath('/products', lang)} class={isActive('/products') ? 'block px-3 py-2.5 font-mono text-xs uppercase tracking-wide text-ink bg-paper-2 rounded-md' : 'block px-3 py-2.5 font-mono text-xs uppercase tracking-wide text-muted hover:text-ink hover:bg-paper-2 rounded-md transition-colors'}>{t('nav.products')}</a>
        <a href={translatePath('/products/inertial-navigation-systems', lang)} class="block pl-6 pr-3 py-2 text-sm text-muted hover:text-ink transition-colors">↳ {isZh ? 'INS 组合导航' : 'INS / GNSS'}</a>
        <a href={translatePath('/products/fog-gyroscopes', lang)} class="block pl-6 pr-3 py-2 text-sm text-muted hover:text-ink transition-colors">↳ {isZh ? '光纤陀螺' : 'FOG Gyroscopes'}</a>
        <a href={translatePath('/products/mems-gyroscopes', lang)} class="block pl-6 pr-3 py-2 text-sm text-muted hover:text-ink transition-colors">↳ {isZh ? 'MEMS 陀螺' : 'MEMS Gyroscopes'}</a>
        <a href={translatePath('/products/imu', lang)} class="block pl-6 pr-3 py-2 text-sm text-muted hover:text-ink transition-colors">↳ {isZh ? 'IMU 与寻北仪' : 'IMU & North Seekers'}</a>
        <a href={translatePath('/products/accelerometers', lang)} class="block pl-6 pr-3 py-2 text-sm text-muted hover:text-ink transition-colors">↳ {isZh ? '加速度计' : 'Accelerometers'}</a>
        <a href={translatePath('/products/fiber-optic', lang)} class="block pl-6 pr-3 py-2 text-sm text-muted hover:text-ink transition-colors">↳ {isZh ? '光纤器件与设备' : 'Fiber Devices & Equipment'}</a>
        <a href={translatePath('/about', lang)} class={isActive('/about') ? 'block px-3 py-2.5 font-mono text-xs uppercase tracking-wide text-ink bg-paper-2 rounded-md' : 'block px-3 py-2.5 font-mono text-xs uppercase tracking-wide text-muted hover:text-ink hover:bg-paper-2 rounded-md transition-colors'}>{t('nav.about')}</a>
        <a href={translatePath('/contact', lang)} class={isActive('/contact') ? 'block px-3 py-2.5 font-mono text-xs uppercase tracking-wide text-ink bg-paper-2 rounded-md' : 'block px-3 py-2.5 font-mono text-xs uppercase tracking-wide text-muted hover:text-ink hover:bg-paper-2 rounded-md transition-colors'}>{t('nav.contact')}</a>
        <div class="pt-3 mt-2 border-t border-rule flex items-center justify-between">
          <div class="flex items-center font-mono text-xs px-3">
            <a href={translatePath(currentPath, 'en')} class={`px-1.5 py-1 ${lang === 'en' ? 'text-ink font-medium' : 'text-muted'}`}>EN</a>
            <span class="text-rule">/</span>
            <a href={translatePath(currentPath, 'zh')} class={`px-1.5 py-1 ${lang === 'zh' ? 'text-ink font-medium' : 'text-muted'}`}>中文</a>
          </div>
          <a href={translatePath('/contact', lang)} class="btn-primary !py-2 !px-4 !text-xs font-mono uppercase tracking-wide">{t('nav.sendInquiry')}</a>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="flex-1 pt-16">
    <slot />
  </main>

  <!-- Footer: Ft5 Statement -->
  <footer class="border-t border-rule">
    <div class="container-page pt-16 pb-10">
      <div class="max-w-3xl">
        <p class="font-display font-semibold text-ink tracking-tight text-2xl sm:text-3xl leading-snug">{t('footer.motto')}</p>
        <p class="text-muted text-sm mt-4 max-w-xl leading-relaxed">{t('footer.tagline')}</p>
      </div>

      <div class="flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-8 mt-10 pt-6 border-t border-rule">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 bg-accent" aria-hidden="true"></span>
          <span class="font-display font-semibold text-ink text-sm">LIOCREBIF</span>
        </div>
        <nav class="flex flex-wrap items-center gap-x-6 gap-y-2" aria-label="Footer">
          <a href={translatePath('/products', lang)} class="footer-link">{t('nav.products')}</a>
          <a href={translatePath('/products/inertial-navigation-systems', lang)} class="footer-link">{t('nav.ins')}</a>
          <a href={translatePath('/products/gyroscopes', lang)} class="footer-link">{t('nav.gyroscopes')}</a>
          <a href={translatePath('/products/fiber-optic', lang)} class="footer-link">{t('nav.fiberOptic')}</a>
          <a href={translatePath('/about', lang)} class="footer-link">{t('footer.aboutUs')}</a>
          <a href={translatePath('/contact', lang)} class="footer-link">{t('footer.contact')}</a>
        </nav>
      </div>

      <div class="flex flex-col sm:flex-row justify-between gap-2 mt-8">
        <p class="font-mono text-xs text-muted">&copy; {currentYear} Wuhan Liocrebif Technology Co., Ltd.</p>
        <div class="flex flex-wrap items-center gap-x-5 gap-y-1">
          <a href="mailto:yaw_sales@liocrebif.com" class="font-mono text-xs text-muted hover:text-ink transition-colors">yaw_sales@liocrebif.com</a>
          <a href="tel:+8618062673472" class="font-mono text-xs text-muted hover:text-ink transition-colors">+86 180-6267-3472</a>
          <a href="https://www.liocrebif.com/" target="_blank" rel="noopener" class="font-mono text-xs text-muted hover:text-ink transition-colors">www.liocrebif.com</a>
        </div>
      </div>
    </div>
  </footer>

  <!-- Floating contact — square hairline, no bounce -->
  <div class="fixed bottom-5 right-5 z-50 flex flex-col gap-2">
    <a href="https://wa.me/8618062673472" class="w-11 h-11 bg-paper border border-rule rounded-lg flex items-center justify-center text-muted hover:text-accent hover:border-accent transition-colors" aria-label="WhatsApp" target="_blank">
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884"/></svg>
    </a>
    <a href="mailto:yaw_sales@liocrebif.com" class="w-11 h-11 bg-paper border border-rule rounded-lg flex items-center justify-center text-muted hover:text-accent hover:border-accent transition-colors" aria-label="Email">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
    </a>
  </div>
</body>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', menu?.classList.contains('hidden') ? 'false' : 'true');
  });

  // Reveal — fade + 10px rise, the only motion on the site
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduced && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add('is-in');
          io.unobserve(e.target);
        }
      }
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  } else {
    document.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-in'));
  }
</script>
</html>
