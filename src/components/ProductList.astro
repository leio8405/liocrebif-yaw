---
/**
 * 产品列表组件（紧凑卡片网格版）
 * - 卡片只展示核心信息（图/型号/名称/简介摘要），完整参数在详情页
 * - 自动按子系列分组（单轴/双轴/三轴…），单组时不显示组标题
 * - 整卡链接到详情页 /products/<model>/
 */
import type { Product } from '../data/products';
import { productSlug } from '../data/products/slug';

interface Props {
  products: Product[];
  lang: 'en' | 'zh';
}

const { products, lang } = Astro.props;
const isZh = lang === 'zh';
const pre = isZh ? '/zh' : '';

const labels = isZh
  ? { detail: '查看详情', specs: '查看参数' }
  : { detail: 'View details', specs: 'View specs' };

// 按子系列分组（保持原顺序）
const groups: { name: string; products: Product[] }[] = [];
for (const p of products) {
  const name = (isZh ? p.subZh : p.subEn) || '';
  const g = groups.find((x) => x.name === name);
  if (g) g.products.push(p);
  else groups.push({ name, products: [p] });
}
const showGroups = groups.length > 1;
---

{groups.map((group) => (
  <div class="mb-12 last:mb-0">
    {showGroups && group.name && (
      <div class="flex items-center gap-4 mb-6">
        <h2 class="font-display font-semibold text-ink text-xl tracking-tight">{group.name}</h2>
        <span class="font-mono text-xs text-muted">{group.products.length}</span>
        <div class="flex-1 border-t border-rule"></div>
      </div>
    )}
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {group.products.map((p) => {
        const detail = pre + '/products/' + productSlug(p.model) + '/';
        const apps = isZh ? p.appsZh : p.appsEn;
        return (
          <a href={detail} class="hairline-card group flex flex-col overflow-hidden hover:border-accent transition-colors">
            <div class="bg-paper-2 h-44 flex items-center justify-center p-4 border-b border-rule">
              {p.image ? (
                <img src={p.image} alt={`${p.model} ${isZh ? p.nameZh : p.nameEn}`} class="max-h-full object-contain" loading="lazy" />
              ) : (
                <span class="font-mono text-xl text-muted tracking-tight text-center break-all px-4">{p.model}</span>
              )}
            </div>
            <div class="p-5 flex flex-col flex-1">
              <div class="flex items-center justify-between gap-2 mb-2.5">
                <span class="tag tag--accent">{isZh ? p.tagZh : p.tagEn}</span>
                <span class="font-mono text-xs text-muted">{p.model}</span>
              </div>
              <h3 class="font-display font-semibold text-ink text-[17px] leading-snug group-hover:text-accent transition-colors">
                {isZh ? p.nameZh : p.nameEn}
              </h3>
              {(isZh ? p.descZh : p.descEn) && (
                <p class="text-muted text-sm mt-2 leading-relaxed line-clamp-3">{isZh ? p.descZh : p.descEn}</p>
              )}
              {apps && apps.length > 0 && (
                <p class="text-muted text-xs mt-3 leading-snug">{apps.slice(0, 3).join(' · ')}</p>
              )}
              <div class="mt-auto pt-4 flex items-center justify-between border-t border-rule mt-4">
                <span class="text-accent text-sm font-medium inline-flex items-center gap-1 group-hover:gap-2 transition-all">
                  {labels.detail} <span aria-hidden="true">→</span>
                </span>
                {p.specTable && p.specTable.rows.length > 0 && (
                  <span class="font-mono text-[11px] text-muted">{p.specTable.rows.length} specs</span>
                )}
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
))}
